# This repository needs NO secrets in files.
# Claude Code authenticates with your own login. Only if you use API billing, export the key in your shell:
#   PowerShell:  $env:ANTHROPIC_API_KEY = "<your key>"
#   bash/zsh:    export ANTHROPIC_API_KEY="<your key>"
# Never put a real key in this file or anywhere in the repo (.env* is git-ignored, and a hook blocks credential writes).

# Optional: point the wger MCP server at a self-hosted instance (default https://wger.de/), configured in .mcp.json.
# WGER_BASE_URL=https://wger.de/
